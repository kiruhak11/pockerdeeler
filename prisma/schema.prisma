generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Room {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique @db.VarChar(8)
  name             String   @db.Text
  status           String   @db.VarChar(32)
  revision         Int      @default(0)
  dealerId         String?  @map("dealer_id") @db.Uuid
  dealerSecretHash String   @map("dealer_secret_hash") @db.Text
  passwordHash     String?  @map("password_hash") @db.Text
  settings         Json     @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  participants        RoomParticipant[]
  players             Player[]
  sessions            GameSession[]
  hands               Hand[]
  actions             PlayerAction[]
  snapshots           GameSnapshot[]
  auditLogs           AuditLog[]
  invites             RoomInvite[]
  chatMessages        RoomChatMessage[]
  members             RoomMember[]
  buyIns              BuyIn[]
  walletLedgerEntries WalletLedgerEntry[]
  roomLedgerEntries   RoomLedgerEntry[]
  treasury            RoomTreasury?
  predictionWallets   PredictionWallet[]
  predictionMarkets   PredictionMarket[]
  behaviorStats       PlayerBehaviorStat[]
  reentryRequests     ReentryRequest[]
  stackReturns        StackReturn[]

  @@index([code])
  @@map("rooms")
}

model RoomCodeRegistry {
  code      String   @id @db.VarChar(8)
  roomType  String   @map("room_type") @db.VarChar(16)
  targetId  String   @map("target_id") @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([roomType, targetId])
  @@index([roomType])
  @@index([targetId])
  @@map("room_code_registry")
}

model OnlineRoom {
  id                    String   @id @default(uuid()) @db.Uuid
  roomCode              String   @unique @map("room_code") @db.VarChar(8)
  visibility            String   @db.VarChar(8)
  ownerId               String   @map("owner_id") @db.VarChar(128)
  status                String   @db.VarChar(16)
  maxPlayers            Int      @default(6) @map("max_players")
  privateJoinSecretHash String?  @map("private_join_secret_hash") @db.Text
  startingStack         BigInt   @default(1000) @map("starting_stack")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  players         OnlineRoomPlayer[]
  stackOperations OnlineStackOperation[]

  @@index([visibility, status])
  @@index([ownerId])
  @@map("online_rooms")
}

model OnlineRoomPlayer {
  id             String    @id @default(uuid()) @db.Uuid
  roomId         String    @map("room_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  seat           Int
  buyIn          BigInt    @map("buy_in")
  status         String    @default("RESERVING") @db.VarChar(24)
  cashOutPending BigInt?   @map("cash_out_pending")
  buyInSequence  Int       @default(0) @map("buy_in_sequence")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at")
  cashedOutAt    DateTime? @map("cashed_out_at") @db.Timestamptz(6)

  room            OnlineRoom             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  stackOperations OnlineStackOperation[]

  @@unique([roomId, userId])
  @@index([userId, status])
  @@index([roomId, status])
  @@map("online_room_players")
}

model OnlineStackOperation {
  id            String    @id @default(uuid()) @db.Uuid
  roomId        String    @map("room_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  reservationId String    @map("reservation_id") @db.Uuid
  requestKey    String    @map("request_key") @db.Uuid
  direction     String    @db.VarChar(8)
  amount        BigInt
  stackBefore   BigInt    @map("stack_before")
  stackAfter    BigInt    @map("stack_after")
  status        String    @default("PREPARED") @db.VarChar(24)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)

  room        OnlineRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservation OnlineRoomPlayer @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId, requestKey])
  @@index([status, createdAt])
  @@index([roomId, status])
  @@map("online_stack_operations")
}

model User {
  id                      String           @id @default(uuid()) @db.Uuid
  username                String           @unique @db.VarChar(64)
  passwordHash            String           @map("password_hash") @db.Text
  phone                   String?          @unique @db.VarChar(16)
  phoneVerifiedAt         DateTime?        @map("phone_verified_at") @db.Timestamptz(6)
  role                    String           @default("USER") @db.VarChar(16)
  isBot                   Boolean          @default(false) @map("is_bot")
  botKey                  String?          @unique @map("bot_key") @db.VarChar(64)
  botSkillTier            String?          @map("bot_skill_tier") @db.VarChar(16)
  botPlayStyle            String?          @map("bot_play_style") @db.VarChar(32)
  botEnabled              Boolean          @default(true) @map("bot_enabled")
  botFencingToken         BigInt           @default(0) @map("bot_fencing_token")
  blockedAt               DateTime?        @map("blocked_at") @db.Timestamptz(6)
  deletedAt               DateTime?        @map("deleted_at") @db.Timestamptz(6)
  mustChangePassword      Boolean          @default(false) @map("must_change_password")
  accountSessions         AccountSession[]
  rewardSessions          RewardSession[]
  balance                 Int              @default(5000)
  predictionRating        Int              @default(1000) @map("prediction_rating")
  tableRating             Int              @default(1000) @map("table_rating")
  tableHandsPlayed        Int              @default(0) @map("table_hands_played")
  tableHandsWon           Int              @default(0) @map("table_hands_won")
  tableCurrentStreak      Int              @default(0) @map("table_current_streak")
  tableBestStreak         Int              @default(0) @map("table_best_streak")
  predictionCount         Int              @default(0) @map("prediction_count")
  predictionWins          Int              @default(0) @map("prediction_wins")
  predictionSplitWins     Int              @default(0) @map("prediction_split_wins")
  premiumType             String           @default("FREE") @map("premium_type") @db.VarChar(16)
  premiumUntil            DateTime?        @map("premium_until") @db.Timestamptz(6)
  selectedAchievementCode String?          @map("selected_achievement_code") @db.VarChar(64)
  lastDailyBonusAt        DateTime?        @map("last_daily_bonus_at") @db.Timestamptz(6)
  miniGameResetAt         DateTime?        @map("mini_game_reset_at") @db.Timestamptz(6)
  leaderboardVisible      Boolean          @default(true) @map("leaderboard_visible")
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  participants                 RoomParticipant[]
  players                      Player[]
  sentFriendRequests           FriendRequest[]                      @relation("FriendRequestSender")
  receivedFriendRequests       FriendRequest[]                      @relation("FriendRequestReceiver")
  friendshipsA                 Friendship[]                         @relation("FriendshipA")
  friendshipsB                 Friendship[]                         @relation("FriendshipB")
  sentRoomInvites              RoomInvite[]                         @relation("RoomInviteSender")
  receivedRoomInvites          RoomInvite[]                         @relation("RoomInviteReceiver")
  roomChatMessages             RoomChatMessage[]
  wallet                       UserWallet?
  onlineRoomPlayers            OnlineRoomPlayer[]
  onlineStackOperations        OnlineStackOperation[]
  roomMemberAccounts           RoomMemberAccount[]
  predictionRatingEvents       PredictionRatingEvent[]
  tableRatingEvents            TableRatingEvent[]
  onlinePokerRatingEvents      OnlinePokerRatingEvent[]
  achievements                 UserAchievement[]
  seasonalStats                SeasonalUserStats[]
  seasonalLeaderboards         SeasonLeaderboard[]
  seasonalRewards              SeasonReward[]
  seasonalSnapshots            SeasonSnapshot[]
  crashBets                    CrashBet[]
  stackReturns                 StackReturn[]
  miniGameSessions             MiniGameSession[]                    @relation("MinesPlayer")
  minesBankSessions            MiniGameSession[]                    @relation("MinesBank")
  minesCommitments             MinesCommitment[]
  miniGameJackpotEntries       MiniGameJackpotEntry[]
  jackpotPrizes                JackpotPrize[]
  tokenPredictions             TokenPrediction[]
  telegramLinkTokens           TelegramLinkToken[]
  telegramSubscription         TelegramSubscription?
  telegramNotificationSettings TelegramNotificationSettings?
  telegramUserEvents           TelegramUserEvent[]
  legalAcceptances             LegalAcceptance[]
  distributionConsents         PersonalDataDistributionConsent[]
  distributionPermissions      PersonalDataDistributionPermission[]
  distributionAudits           PersonalDataDistributionAudit[]
  legalCheckoutSessions        LegalCheckoutSession[]
  payments                     Payment[]
  refundRequests               RefundRequest[]
  premiumSubscriptions         PremiumSubscription[]
  premiumSettings              PremiumUserSettings?

  @@index([username])
  @@index([isBot, botEnabled])
  @@map("users")
}

model LegalDocument {
  id                   String                            @id @default(uuid()) @db.Uuid
  type                 String                            @db.VarChar(48)
  version              String                            @db.VarChar(32)
  title                String                            @db.Text
  content              String                            @db.Text
  contentPath          String?                           @map("content_path") @db.Text
  contentHash          String                            @map("content_hash") @db.VarChar(64)
  effectiveFrom        DateTime                          @map("effective_from") @db.Timestamptz(6)
  publishedAt          DateTime                          @map("published_at") @db.Timestamptz(6)
  isActive             Boolean                           @default(false) @map("is_active")
  createdAt            DateTime                          @default(now()) @map("created_at") @db.Timestamptz(6)
  acceptances          LegalAcceptance[]
  distributionConsents PersonalDataDistributionConsent[]

  @@unique([type, version])
  @@index([type, isActive, effectiveFrom])
  @@map("legal_documents")
}

model LegalAcceptance {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  documentId  String        @map("document_id") @db.Uuid
  version     String        @db.VarChar(32)
  contentHash String        @map("content_hash") @db.VarChar(64)
  context     String        @db.VarChar(32)
  acceptedAt  DateTime      @default(now()) @map("accepted_at") @db.Timestamptz(6)
  ip          String        @db.VarChar(64)
  userAgent   String        @map("user_agent") @db.Text
  paymentId   String?       @map("payment_id") @db.VarChar(128)
  orderId     String?       @map("order_id") @db.VarChar(128)
  requestId   String        @map("request_id") @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  document    LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([requestId, documentId])
  @@index([userId, documentId, context])
  @@index([userId, acceptedAt])
  @@index([paymentId])
  @@index([orderId])
  @@map("legal_acceptances")
}

model PersonalDataDistributionConsent {
  id              String                               @id @default(uuid()) @db.Uuid
  userId          String                               @map("user_id") @db.Uuid
  documentId      String                               @map("document_id") @db.Uuid
  documentVersion String                               @map("document_version") @db.VarChar(32)
  acceptedAt      DateTime                             @default(now()) @map("accepted_at") @db.Timestamptz(6)
  updatedAt       DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(6)
  revokedAt       DateTime?                            @map("revoked_at") @db.Timestamptz(6)
  requestId       String                               @map("request_id") @db.Uuid
  ip              String                               @db.VarChar(64)
  userAgent       String                               @map("user_agent") @db.Text
  user            User                                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  document        LegalDocument                        @relation(fields: [documentId], references: [id], onDelete: Restrict)
  permissions     PersonalDataDistributionPermission[]
  audits          PersonalDataDistributionAudit[]

  @@unique([userId, documentId, documentVersion])
  @@index([userId, revokedAt])
  @@map("personal_data_distribution_consents")
}

model PersonalDataDistributionPermission {
  id        String                          @id @default(uuid()) @db.Uuid
  userId    String                          @map("user_id") @db.Uuid
  consentId String                          @map("consent_id") @db.Uuid
  category  String                          @db.VarChar(32)
  isActive  Boolean                         @default(true) @map("is_active")
  grantedAt DateTime                        @default(now()) @map("granted_at") @db.Timestamptz(6)
  updatedAt DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)
  revokedAt DateTime?                       @map("revoked_at") @db.Timestamptz(6)
  user      User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  consent   PersonalDataDistributionConsent @relation(fields: [consentId], references: [id], onDelete: Cascade)

  @@unique([userId, category, isActive], map: "pdd_permissions_user_category_active_key")
  @@unique([consentId, category], map: "pdd_permissions_consent_category_key")
  @@index([userId, category, isActive], map: "pdd_permissions_user_category_active_idx")
  @@map("personal_data_distribution_permissions")
}

model PersonalDataDistributionAudit {
  id              String                           @id @default(uuid()) @db.Uuid
  userId          String                           @map("user_id") @db.Uuid
  consentId       String?                          @map("consent_id") @db.Uuid
  documentVersion String                           @map("document_version") @db.VarChar(32)
  action          String                           @db.VarChar(16)
  categories      Json                             @db.JsonB
  createdAt       DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  ip              String                           @db.VarChar(64)
  userAgent       String                           @map("user_agent") @db.Text
  user            User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  consent         PersonalDataDistributionConsent? @relation(fields: [consentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("personal_data_distribution_audits")
}

model LegalCheckoutSession {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  context     String   @db.VarChar(32)
  paymentType String?  @map("payment_type") @db.VarChar(32)
  productKey  String?  @map("product_key") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment     Payment?

  @@index([userId, createdAt])
  @@map("legal_checkout_sessions")
}

model Payment {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  orderId           String                @unique @default(uuid()) @map("order_id") @db.VarChar(64)
  yookassaPaymentId String?               @unique @map("yookassa_payment_id") @db.VarChar(128)
  idempotencyKey    String                @unique @map("idempotency_key") @db.Uuid
  checkoutId        String?               @unique @map("checkout_id") @db.Uuid
  provider          String                @default("YOOKASSA") @db.VarChar(24)
  type              String                @db.VarChar(32)
  productKey        String                @map("product_key") @db.VarChar(32)
  amount            Decimal               @db.Decimal(12, 2)
  currency          String                @default("RUB") @db.VarChar(3)
  status            String                @default("PENDING") @db.VarChar(24)
  providerStatus    String?               @map("provider_status") @db.VarChar(32)
  description       String                @db.VarChar(128)
  metadata          Json                  @default("{}") @db.JsonB
  providerData      Json                  @default("{}") @map("provider_data") @db.JsonB
  confirmationUrl   String?               @map("confirmation_url") @db.Text
  returnUrl         String                @map("return_url") @db.Text
  providerCreatedAt DateTime?             @map("provider_created_at") @db.Timestamptz(6)
  expiresAt         DateTime?             @map("expires_at") @db.Timestamptz(6)
  paidAt            DateTime?             @map("paid_at") @db.Timestamptz(6)
  processedAt       DateTime?             @map("processed_at") @db.Timestamptz(6)
  canceledAt        DateTime?             @map("canceled_at") @db.Timestamptz(6)
  lastSyncedAt      DateTime?             @map("last_synced_at") @db.Timestamptz(6)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  refundRequest     RefundRequest?
  checkout          LegalCheckoutSession? @relation(fields: [checkoutId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([type, status, createdAt])
  @@index([userId, type, productKey])
  @@map("payments")
}

model RefundRequest {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  paymentId      String    @unique @map("payment_id") @db.Uuid
  purchaseType   String    @map("purchase_type") @db.VarChar(32)
  reason         String    @db.Text
  requestedAt    DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  status         String    @default("REQUESTED") @db.VarChar(24)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(6)
  decisionReason String?   @map("decision_reason") @db.Text
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  payment        Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
  @@map("refund_requests")
}

model PremiumSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  plan      String   @db.VarChar(16)
  startedAt DateTime @map("started_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  status    String   @default("ACTIVE") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
  @@map("premium_subscriptions")
}

model PremiumUserSettings {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  settings  Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("premium_user_settings")
}

model TelegramLinkToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("telegram_link_tokens")
}

model TelegramSubscription {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  chatId         String   @unique @map("chat_id") @db.VarChar(64)
  telegramUserId String   @map("telegram_user_id") @db.VarChar(64)
  username       String?  @db.VarChar(128)
  firstName      String?  @map("first_name") @db.VarChar(128)
  isActive       Boolean  @default(true) @map("is_active")
  subscribedAt   DateTime @default(now()) @map("subscribed_at") @db.Timestamptz(6)
  lastSeenAt     DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive, lastSeenAt])
  @@map("telegram_subscriptions")
}

model TelegramNotificationSettings {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  settings  Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_notification_settings")
}

model TelegramUserEvent {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  category    String    @db.VarChar(32)
  eventKey    String    @unique @map("event_key") @db.VarChar(160)
  text        String    @db.Text
  attemptedAt DateTime? @map("attempted_at") @db.Timestamptz(6)
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([attemptedAt, createdAt])
  @@map("telegram_user_events")
}

model AccountSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account_sessions")
}

model PhoneVerification {
  id          String    @id @default(uuid()) @db.Uuid
  phone       String    @db.VarChar(16)
  browserHash String    @map("browser_hash")
  requestId   String    @unique @map("request_id") @db.Uuid
  purpose     String    @db.VarChar(16)
  status      String    @default("creating") @db.VarChar(16)
  providerId  String?   @map("provider_id")
  callPhone   String?   @map("call_phone")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  checkedAt   DateTime? @map("checked_at") @db.Timestamptz(6)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)

  @@index([phone, createdAt])
  @@index([browserHash, createdAt])
  @@map("phone_verifications")
}

model RewardSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  status      String    @default("watching") @db.VarChar(16)
  amount      Int
  provider    String    @default("self_promo") @db.VarChar(32)
  requestId   String    @unique @map("request_id") @db.Uuid
  readyAt     DateTime  @map("ready_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
